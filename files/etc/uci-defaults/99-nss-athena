#!/bin/sh
# ============================================================
# 雅典娜 RE-CS-02 首启初始化脚本
# 作用：关闭与 NSS 冲突的软件 offload + 设时区 + 启动 athena_led
# 编译时由 OpenWrt 自动打进固件 /etc/uci-defaults/
# 首次启动执行一次后自动删除
# ============================================================

# NSS 满血必须关掉 OpenWrt 自带 offload，否则加速被绕开
uci set network.@device[0].packet_steering=0
uci set network.@device[0].flow_offloading=0
uci set network.@device[0].flow_offloading_hw=0
uci commit network

# 时区
uci set system.@system[0].zonename='Asia/Shanghai'
uci set system.@system[0].timezone='CST-8'
uci commit system

# 启动 athena_led 点阵屏服务
/etc/init.d/athena_led enable
/etc/init.d/athena_led start

echo "===== NSS + Timezone + Athena LED initialized ====="
exit 0
