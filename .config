# ============================================================
# qosmio/openwrt-ipq @ qualcommax-6.x-nss-wifi
# 设备: JDCloud Athena AX6600 (RE-CS-02, IPQ6010)
# 特性: 满血 NSS + LuCI 中文 Argon + SSH + 大分区
#       + athena-led 点阵屏 + iStore + OpenAppFilter
#       + Gecoos AC + Harbor File
# ============================================================

# -------- 架构与目标 --------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -march=armv8-a+crypto+crc -mtune=cortex-a53"

# -------- 镜像与分区 --------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_KERNEL_BUILD_USER="nss"
CONFIG_KERNEL_BUILD_DOMAIN="openwrt-ipq"
CONFIG_CCACHE=y

# -------- Rust 工具链（athena-led 核心必须）--------
CONFIG_RUST=y

# -------- NSS 固件版本（IPQ6010 = 11.4） --------
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_PACKAGE_nss-firmware-ipq6018=y

# -------- NSS 核心驱动（满血必需） --------
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-gmac=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-ecm-standard=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
CONFIG_PACKAGE_kmod-nss-ifb=y

# -------- NSS 可选隧道模块 --------
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y

# -------- 无线 ath11k --------
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_firmware-qcom-ath11k=y
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-02=y
CONFIG_PACKAGE_ath11k-firmware-qcn9074=y

# -------- 网络基础 --------
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_ca-bundle=y

# -------- LuCI 与中文 --------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# -------- athena-led 点阵屏驱动 --------
CONFIG_PACKAGE_athena-led=y
CONFIG_PACKAGE_luci-app-athena-led=y

# -------- iStore 应用商店 --------
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_curl=y

# -------- OpenAppFilter 应用过滤 --------
CONFIG_PACKAGE_luci-app-openappfilter=y
CONFIG_PACKAGE_openappfilter=y

# -------- Gecoos AC 控制器 --------
CONFIG_PACKAGE_luci-app-gecoosac=y

# -------- Harbor File 文件管理器 --------
CONFIG_PACKAGE_luci-app-harbor-file=y

# -------- Shell / 时区 / 工具 --------
CONFIG_PACKAGE_openssh-server=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_DEFAULT_TIMEZONE="Asia/Shanghai"
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-tracepath=y

# -------- 显式关闭冲突项（NSS 必须） --------
CONFIG_DEFAULT_flow_offloading=n
CONFIG_DEFAULT_flow_offloading_hw=n
CONFIG_PACKET_STEERING=n
