# ============================================================
# qosmio NSS for JDCloud RE-CS-02 (qualcommax-6.x-nss-wifi-6.9)
# 雅典娜点阵屏 + iStore + OpenAppFilter + Gecoos + Harbor
# ============================================================

# --- 目标设备 ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# --- 工具链 ---
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_RUST=y

# --- 内核 ---
CONFIG_LINUX_6_9=y

# --- NSS 核心 ---
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-ppp-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-ipv6-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-gre-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-cfi-cryptoapi=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-nss-cfi=y
CONFIG_PACKAGE_nss-firmware-ipq6018=y
CONFIG_PACKAGE_nss-firmware-ipq60xx=y
CONFIG_PACKAGE_nss-packages=y

# --- NSS 用户态 ---
CONFIG_PACKAGE_qca-nss-clients=y
CONFIG_PACKAGE_qca-nss-bridge-mgr=y
CONFIG_PACKAGE_qca-nss-vlan-mgr=y
CONFIG_PACKAGE_qca-nss-gre-mgr=y
CONFIG_PACKAGE_qca-nss-lag-mgr=y
CONFIG_PACKAGE_qca-nss-map-t-mgr=y
CONFIG_PACKAGE_qca-nss-ppp-mgr=y
CONFIG_PACKAGE_qca-nss-qdisc=y

# --- 关闭冲突的 offload ---
# CONFIG_PACKAGE_kmod-nft-offload is not set
# CONFIG_PACKAGE_kmod-ipt-offload is not set
# CONFIG_PACKAGE_firewall-nftables is not set

# --- 无线 (ath11k) ---
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_hostapd-utils=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# --- 网络工具 ---
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y

# --- LuCI 基础 ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_LUCI_LANG_zh_Hans=y

# --- 雅典娜点阵屏 ---
CONFIG_PACKAGE_athena-led=y
CONFIG_PACKAGE_luci-app-athena-led=y

# --- iStore 应用商店 ---
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_curl=y

# --- OpenAppFilter 应用过滤 ---
CONFIG_PACKAGE_luci-app-openappfilter=y
CONFIG_PACKAGE_openappfilter=y

# --- Gecoos AC 控制器 ---
CONFIG_PACKAGE_luci-app-gecoosac=y

# --- Harbor File 文件管理器 ---
CONFIG_PACKAGE_luci-app-harbor-file=y

# --- 常用工具 ---
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_findutils=y

# --- 文件系统 ---
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_e2fsprogs=y

# --- 签名 ---
# 关闭 opkg/apk 签名强制 (snapshot 源常无签名)
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_apk-mbedtls=y
