# ===== Target System =====
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000m-emmc=y

# ===== Toolchain =====
CONFIG_HAS_FPU=y
CONFIG_LIBC="musl"
CONFIG_GCC_USE_VERSION_13=y
CONFIG_DEFAULT_smallsmp=y

# ===== Luci Web 管理界面 =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-package-manager=y

# ===== 网络基础 =====
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_wpad-openssl=y

# ===== MTK WiFi (MT7981 内置 + MT7915E 外置) =====
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-wmac=y

# ===== MTK HNAT 硬件加速 =====
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_nftables=y

# ===== eMMC 存储支持 (F2FS) =====
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_f2fsck=y

# ===== PHY / USB =====
CONFIG_PACKAGE_kmod-phy-mtk-tphy=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y

# ===== 实用工具 =====
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_htop=y

# ===== 关闭其他设备（加速编译） =====
# 所有其他 CONFIG_TARGET_mediatek_filogic_DEVICE_* 均为 NOT set
